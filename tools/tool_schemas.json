{
  "version": "0.1.0",
  "description": "ORBIT tool registry schemas. Permission levels: read < controlled < escalation < restricted. All tools return the standard ToolResult envelope.",
  "result_envelope": {
    "type": "object",
    "properties": {
      "request_id": {"type": "string"},
      "status": {"type": "string", "enum": ["success", "failed", "rejected", "timeout", "requires_approval", "unavailable"]},
      "robot_id": {"type": ["string", "null"]},
      "result": {"type": ["object", "null"]},
      "error": {"type": ["string", "null"]},
      "timestamp": {"type": "string", "format": "date-time"}
    },
    "required": ["request_id", "status", "timestamp"]
  },
  "tools": [
    {
      "name": "get_robot_status",
      "description": "Read a robot's battery, location, current mission and health.",
      "permission": "read",
      "timeout_s": 5,
      "parameters": {
        "type": "object",
        "properties": {
          "robot_id": {"type": "string", "pattern": "^ORBIT_[0-9]{3}$"}
        },
        "required": ["robot_id"],
        "additionalProperties": false
      }
    },
    {
      "name": "get_environment_status",
      "description": "Read latest environmental readings (temperature, humidity, smoke, gas, water) for a zone.",
      "permission": "read",
      "timeout_s": 5,
      "parameters": {
        "type": "object",
        "properties": {
          "zone_id": {"type": "string"},
          "metrics": {
            "type": "array",
            "items": {"type": "string", "enum": ["temperature", "humidity", "smoke", "gas", "water_leak", "noise"]},
            "minItems": 1
          }
        },
        "required": ["zone_id"],
        "additionalProperties": false
      }
    },
    {
      "name": "get_camera_observations",
      "description": "Read processed camera events (detections, zone events) — never raw images.",
      "permission": "read",
      "timeout_s": 5,
      "parameters": {
        "type": "object",
        "properties": {
          "robot_id": {"type": "string", "pattern": "^ORBIT_[0-9]{3}$"},
          "zone_id": {"type": "string"},
          "since_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}
        },
        "required": ["robot_id"],
        "additionalProperties": false
      }
    },
    {
      "name": "get_mission_status",
      "description": "Read the state and step progress of a mission.",
      "permission": "read",
      "timeout_s": 5,
      "parameters": {
        "type": "object",
        "properties": {
          "mission_id": {"type": "string", "pattern": "^mission_[A-Za-z0-9_]+$"}
        },
        "required": ["mission_id"],
        "additionalProperties": false
      }
    },
    {
      "name": "get_fleet_status",
      "description": "Read status of all robots in the fleet, optionally filtered by capability.",
      "permission": "read",
      "timeout_s": 5,
      "parameters": {
        "type": "object",
        "properties": {
          "capability": {"type": "string", "enum": ["camera", "thermal", "vibration", "gas", "microphone", "lidar"]}
        },
        "additionalProperties": false
      }
    },
    {
      "name": "create_mission",
      "description": "Create a mission from an ordered list of steps. Validated by the mission manager before execution.",
      "permission": "controlled",
      "timeout_s": 10,
      "parameters": {
        "type": "object",
        "properties": {
          "objective": {"type": "string", "minLength": 3, "maxLength": 300},
          "robot_id": {"type": "string", "pattern": "^ORBIT_[0-9]{3}$"},
          "priority": {"type": "string", "enum": ["low", "normal", "high"]},
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "object",
              "properties": {
                "action": {"type": "string", "enum": ["navigate_to_waypoint", "inspect_equipment", "get_environment_status", "get_camera_observations", "generate_report"]},
                "target": {"type": "string"}
              },
              "required": ["action", "target"],
              "additionalProperties": false
            }
          }
        },
        "required": ["objective", "steps"],
        "additionalProperties": false
      }
    },
    {
      "name": "navigate_to_waypoint",
      "description": "Request navigation to a configured waypoint. Nav2 handles path planning and obstacle avoidance.",
      "permission": "controlled",
      "timeout_s": 600,
      "parameters": {
        "type": "object",
        "properties": {
          "robot_id": {"type": "string", "pattern": "^ORBIT_[0-9]{3}$"},
          "waypoint_id": {"type": "string"},
          "priority": {"type": "string", "enum": ["low", "normal", "high"]}
        },
        "required": ["robot_id", "waypoint_id"],
        "additionalProperties": false
      }
    },
    {
      "name": "inspect_equipment",
      "description": "Run an inspection on a configured asset using available sensors; returns readings and diagnostic results.",
      "permission": "controlled",
      "timeout_s": 300,
      "parameters": {
        "type": "object",
        "properties": {
          "robot_id": {"type": "string", "pattern": "^ORBIT_[0-9]{3}$"},
          "asset_id": {"type": "string"},
          "checks": {
            "type": "array",
            "items": {"type": "string", "enum": ["vibration", "temperature", "acoustic", "thermal_image", "visual"]},
            "minItems": 1
          }
        },
        "required": ["robot_id", "asset_id"],
        "additionalProperties": false
      }
    },
    {
      "name": "request_peer_verification",
      "description": "Ask the fleet manager to have another capable robot verify an event.",
      "permission": "controlled",
      "timeout_s": 15,
      "parameters": {
        "type": "object",
        "properties": {
          "event_id": {"type": "string", "pattern": "^evt_[A-Za-z0-9_]+$"},
          "required_capability": {"type": "string", "enum": ["camera", "thermal", "vibration", "gas", "microphone", "lidar"]}
        },
        "required": ["event_id"],
        "additionalProperties": false
      }
    },
    {
      "name": "assign_robot_task",
      "description": "Assign an existing mission to a robot. Fleet manager enforces duplicate suppression and capability checks.",
      "permission": "controlled",
      "timeout_s": 15,
      "parameters": {
        "type": "object",
        "properties": {
          "mission_id": {"type": "string", "pattern": "^mission_[A-Za-z0-9_]+$"},
          "robot_id": {"type": "string", "pattern": "^ORBIT_[0-9]{3}$"}
        },
        "required": ["mission_id"],
        "additionalProperties": false
      }
    },
    {
      "name": "generate_report",
      "description": "Generate a report from recorded evidence for a mission, zone or asset. Only cites stored observations.",
      "permission": "controlled",
      "timeout_s": 60,
      "parameters": {
        "type": "object",
        "properties": {
          "scope": {"type": "string", "enum": ["mission", "zone", "asset", "fleet"]},
          "target_id": {"type": "string"},
          "format": {"type": "string", "enum": ["summary", "detailed"]}
        },
        "required": ["scope", "target_id"],
        "additionalProperties": false
      }
    },
    {
      "name": "send_alert",
      "description": "Send an alert to authorized recipients through the approved escalation workflow.",
      "permission": "escalation",
      "timeout_s": 10,
      "parameters": {
        "type": "object",
        "properties": {
          "severity": {"type": "string", "enum": ["info", "warning", "critical"]},
          "message": {"type": "string", "minLength": 3, "maxLength": 500},
          "event_id": {"type": "string", "pattern": "^evt_[A-Za-z0-9_]+$"},
          "recipient_group": {"type": "string", "enum": ["operators", "maintenance", "security", "caregivers"]}
        },
        "required": ["severity", "message", "recipient_group"],
        "additionalProperties": false
      }
    },
    {
      "name": "request_human_assistance",
      "description": "Escalate to a human. Used for emergencies, wellbeing crises, permission requests and anything ORBIT must not decide alone.",
      "permission": "escalation",
      "timeout_s": 10,
      "parameters": {
        "type": "object",
        "properties": {
          "category": {"type": "string", "enum": ["medical_emergency", "wellbeing_crisis", "safety_hazard", "permission_request", "user_request", "robot_fault"]},
          "priority": {"type": "string", "enum": ["low", "normal", "high", "critical"]},
          "summary": {"type": "string", "minLength": 3, "maxLength": 500},
          "location_hint": {"type": "string"}
        },
        "required": ["category", "priority", "summary"],
        "additionalProperties": false
      }
    }
  ],
  "permissions_by_role": {
    "guest": ["read"],
    "user": ["read", "controlled"],
    "operator": ["read", "controlled", "escalation"],
    "admin": ["read", "controlled", "escalation", "restricted"]
  },
  "always_allowed": ["request_human_assistance"],
  "notes": [
    "request_human_assistance is allowed for every role so emergencies are never blocked by permissions.",
    "Users may request (not send) alerts; the system converts a user's alert request into request_human_assistance.",
    "No tool changes machine settings, unlocks doors or enters restricted zones in v1."
  ]
}
